# =============================================================================
# AI Editorial Factory - variabili di ambiente
# -----------------------------------------------------------------------------
# Copia questo file in .env.local e compila i valori.
# .env.local e' gia' ignorato da Git: NON inserire qui segreti reali.
# =============================================================================

# -----------------------------------------------------------------------------
# Applicazione
# -----------------------------------------------------------------------------
# URL assoluto dell'applicazione. In locale: http://localhost:3000
# Su Vercel: l'URL di produzione (es. https://ai-editorial-factory.vercel.app).
# Usato per costruire i link inviati via email (conferma account, reset password).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase
# Dashboard > Project Settings > API Keys
# -----------------------------------------------------------------------------
# URL del progetto, nella forma https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (prefisso sb_publishable_). Puo' essere esposta al browser:
# da sola non concede alcun accesso, la Row Level Security resta applicata.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret / service role key (prefisso sb_secret_ oppure la legacy service_role).
# IGNORA la Row Level Security: da usare solo lato server, mai nel browser.
# Su Vercel va configurata come variabile NON esposta (senza prefisso NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Provider AI
# Valori ammessi:
#   AI_TEXT_PROVIDER  = mock | openai | anthropic
#   AI_IMAGE_PROVIDER = mock | openai
# Lasciando "mock" l'intero flusso e' percorribile senza consumare crediti.
# -----------------------------------------------------------------------------
AI_TEXT_PROVIDER=mock
AI_TEXT_MODEL=mock-text-1
AI_IMAGE_PROVIDER=mock
AI_IMAGE_MODEL=mock-image-1

# Facoltative: necessarie soltanto se il provider corrispondente non e' "mock".
# OpenAI:    https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/settings/keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
