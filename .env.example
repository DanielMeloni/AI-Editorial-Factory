# =============================================================================
# AI Editorial Factory - variabili di ambiente
# -----------------------------------------------------------------------------
# Copia questo file in .env.local e compila i valori.
# .env.local e' gia' ignorato da Git: NON inserire qui segreti reali.
# =============================================================================

# -----------------------------------------------------------------------------
# Applicazione
# -----------------------------------------------------------------------------
# URL assoluto dell'applicazione. In locale: http://localhost:3000
# Su Vercel: l'URL di produzione (es. https://ai-editorial-factory.vercel.app).
# Usato per costruire i link inviati via email (conferma account, reset password).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase
# Dashboard > Project Settings > API Keys
# -----------------------------------------------------------------------------
# URL del progetto, nella forma https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (prefisso sb_publishable_). Puo' essere esposta al browser:
# da sola non concede alcun accesso, la Row Level Security resta applicata.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret / service role key (prefisso sb_secret_ oppure la legacy service_role).
# IGNORA la Row Level Security: da usare solo lato server, mai nel browser.
# Su Vercel va configurata come variabile NON esposta (senza prefisso NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Provider AI
# Valori ammessi:
#   AI_TEXT_PROVIDER  = mock | openai | anthropic
#   AI_IMAGE_PROVIDER = mock | openai
# Lasciando "mock" l'intero flusso e' percorribile senza consumare crediti.
# -----------------------------------------------------------------------------
AI_TEXT_PROVIDER=mock
AI_TEXT_MODEL=mock-text-1

# Routing testuale per singolo agente. Se una variabile manca, l'agente usa
# AI_TEXT_PROVIDER / AI_TEXT_MODEL. Formato: provider:modello.
# I fallback sono provati in ordine solo per errori tecnici recuperabili.
AI_AGENT_FALLBACKS=openai:gpt-5.6-terra,anthropic:claude-sonnet-5
AI_AGENT_TECHNICAL_VERIFIER=openai:gpt-5.6-terra
AI_AGENT_SOURCE_AUDITOR=anthropic:claude-sonnet-5
AI_AGENT_CURRICULUM=anthropic:claude-sonnet-5
AI_AGENT_TECHNICAL_WRITER=anthropic:claude-sonnet-5
AI_AGENT_TEACHING=openai:gpt-5.6-terra
AI_AGENT_VISUAL_ART_DIRECTOR=openai:gpt-5.6-terra
AI_AGENT_EDITORIAL_REVIEWER=openai:gpt-5.6-sol
AI_IMAGE_PROVIDER=mock
AI_IMAGE_MODEL=mock-image-1

# Facoltative: necessarie soltanto se il provider corrispondente non e' "mock".
# OpenAI:    https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/settings/keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Ricerca web delle fonti
# -----------------------------------------------------------------------------
# «mock» (predefinito) non cerca e non inventa: restituisce un elenco vuoto e lo
# dichiara. Con «gemini», «anthropic» o «openai» la ricerca avviene davvero,
# tramite lo strumento nativo del modello, e usa la chiave del fornitore scelto.
#
# Per Gemini viene usata la Interactions API con Google Search. Per le nuove
# utenze i modelli 2.5 non sono disponibili e Gemini 3 richiede billing.
# La chiave si crea in un minuto su https://aistudio.google.com/apikey
#
# Il modello deve appartenere al fornitore: gemini-3.6-flash per gemini,
# claude-sonnet-5 per anthropic, gpt-5.6 per openai. Se non corrisponde viene
# corretto, con un avviso.
#
# Ogni indirizzo proposto viene comunque aperto prima di essere mostrato: chi
# non risponde non compare, e il titolo che leggi è quello letto dalla pagina.
AI_SEARCH_PROVIDER=openai
AI_SEARCH_MODEL=gpt-5.6-luna
# AI_SEARCH_PROVIDER=gemini
# AI_SEARCH_MODEL=gemini-3.6-flash
# GEMINI_API_KEY=
# Per tornare alla modalità senza consumo:
# AI_SEARCH_PROVIDER=mock
# AI_SEARCH_MODEL=mock-search-1
